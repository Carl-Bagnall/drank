{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drank",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker serves both the built React SPA and the /api routes.
  // `run_worker_first` is essential: without it the SPA fallback would
  // answer /api/* with index.html instead of letting the Worker 404 in JSON.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drank",
      "database_id": "PLACEHOLDER_SET_BY_WRANGLER_D1_CREATE",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": { "enabled": true }
}
